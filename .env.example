# ANTHROPIC_API_KEY: Required for Claude AI API calls.
# Set this to your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Required for address autocomplete (Places API).
# Enable "Places API" at https://console.cloud.google.com/apis/library/places-backend.googleapis.com
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# VITE_TICKETMASTER_API_KEY: Required for live event suggestions (Ticketmaster Discovery API).
# Get a free key at https://developer.ticketmaster.com — 5,000 requests/day on free tier.
VITE_TICKETMASTER_API_KEY="your_ticketmaster_api_key_here"

# VITE_EVENTBRITE_TOKEN: Required for family/child-friendly event suggestions (Eventbrite API).
# Get your token at https://www.eventbrite.com/platform/api-keys
VITE_EVENTBRITE_TOKEN="your_eventbrite_token_here"